{% extends 'index.twig' %}

{% block title %}Joomla! Framework Status - {{ package.display }} Package{% endblock %}

{% block metaDescription %}Release history for the Joomla! Framework {{ package.display }} package.{% endblock %}

{% block content %}
<section class="status container">
    <h1 class="centered-title">Release Data for {{ package.display }} Package <a href="https://github.com/joomla-framework/{{ package.repo }}"><span class="fab fa-github" aria-hidden="true"></span><span class="visually-hidden">Open {{ package.display }} on GitHub</span></a></h1>
    {% if not package.abandoned %}
        <p class="text-center">
            <a href="https://github.com/joomla-framework/{{ package.repo }}/actions/workflows/ci.yml"><img src="https://github.com/joomla-framework/{{ package.repo }}/actions/workflows/ci.yml/badge.svg" alt="Build status of the default branch"></a>
        </p>
    {% endif %}
    {% if package.abandoned %}
        <div class="alert alert-danger">
            <h4>Abandoned Package</h4>
            <p>This package has been abandoned and is no longer supported.</p>
        </div>
    {% elseif package.deprecated %}
        <div class="alert alert-warning">
            <h4>Deprecated Package</h4>
            <p>This package has been deprecated and will soon no longer be supported.</p>
        </div>
    {% endif %}
    <table class="table table-striped table-sm nice-responsive-table">
        <thead>
            <tr>
                <th scope="col">Version</th>
                <th scope="col">Release Date</th>
            </tr>
        </thead>
        <tbody>
            {% for release in releases %}
                <tr>
                    <td data-label="Version">{{ release.version }}</td>
                    <td data-label="Release Date">{{ release.release_date }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}
