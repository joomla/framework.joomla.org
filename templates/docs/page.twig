{% extends 'index.twig' %}

{% block title %}Joomla! Framework Documentation - {{ activePackage.display }} Package{% endblock %}

{% block metaDescription %}{{ packageSummary ?: 'Documentation of the ' ~ activePackage.display ~ ' package of the Joomla! Framework.' }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ preload(asset('css/code.css', 'versioned'), 'preload', {'as': 'style'}) }}" type="text/css"{{ sri('css/code.css') }}>
{% endblock %}

{% block content %}
    <div class="d-flex">
        <button class="btn btn-dark d-md-none sidebartoggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-expanded="false" aria-label="Toggle mainnavigation">Show Navigation</button>
        <div id="sidebar" class="col_sidebar p-4 bg-light bg-gradient border-end flex-lg-shrink-0 sticky-lg-top overflow-auto">
            <form action="{{ route('docs/search') }}" method="get" role="search" class="mb-4">
                <label class="visually-hidden" for="sidebar-search">Search the documentation</label>
                <div class="input-group input-group-sm">
                    <input type="search" id="sidebar-search" name="q" class="form-control" placeholder="Search the documentation" required>
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </form>
            <nav>
                <span class="text-uppercase fw-bolder fs-6">Package Index</span>
                    {{ sidebarContents|raw }}
                <h3>Package List</h3>
                <ul class="list-unstyled">
                    {% for package in packages %}
                        {% if package.stable %}
                            <li>
                                <a class="text-decoration-none px-3 py-2 d-block" href="{{ route('docs/latest/' ~ package.package) }}">{{ package.display }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </nav>
        </div>
        <main class="col_main container">
            <div class="row">
                <div class="col">
                    {% if versionInfo and versionInfo.versions|length > 1 %}
                        <nav class="d-flex justify-content-end align-items-center gap-2 mb-3" aria-label="Documentation versions">
                            <span class="text-body-secondary small">Version</span>
                            <div class="btn-group btn-group-sm">
                                {% for entry in versionInfo.versions %}
                                    <a href="{{ route('docs/' ~ entry.version ~ '/' ~ activePackage.package ~ '/' ~ entry.page) }}" class="btn {{ entry.current ? 'btn-primary' : 'btn-outline-primary' }}"{% if entry.current %} aria-current="page"{% endif %}>
                                        {{ entry.version }}{% if not entry.stable %} <span class="visually-hidden">(in development)</span><span aria-hidden="true">dev</span>{% endif %}
                                    </a>
                                {% endfor %}
                            </div>
                        </nav>
                    {% endif %}
                    {% if versionInfo and not versionInfo.stable %}
                        <div class="alert alert-warning" role="note">
                            This is the documentation of the <strong>{{ versionInfo.current }}</strong> branch, which is still in development and not released yet. It may change at any time.
                            {% if versionInfo.stableVersion %}
                                For the current release, read the <a class="alert-link" href="{{ route('docs/' ~ versionInfo.stableVersion ~ '/' ~ activePackage.package ~ '/' ~ versionInfo.stablePage) }}">{{ versionInfo.stableVersion }} documentation</a>.
                            {% endif %}
                        </div>
                    {% endif %}
                    <h1 class="centered-title">Framework Documentation - {{ activePackage.display }} Package</h1>
                    {{ contents|raw }}
                    {% if versionInfo %}
                        <p class="border-top mt-5 pt-3 small">
                            <a href="{{ versionInfo.editUrl }}"><span class="fab fa-github" aria-hidden="true"></span> Edit this page on GitHub</a>
                        </p>
                    {% endif %}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
